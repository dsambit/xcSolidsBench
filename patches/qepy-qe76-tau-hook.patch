+   SUBROUTINE qepy_set_extkin(vin, gather)
+      ! xcSolidsBench tau hook: set the external tau potential (d e_xc / d tau_sigma, per spin, dimensionless),
+      ! a copy of qepy_set_extpot for embed%extkin
+      USE kinds,                ONLY : DP
+      USE fft_base,             ONLY : dfftp
+      USE lsda_mod,             ONLY : nspin
+      USE mp,                   ONLY : mp_bcast
+      !
+      IMPLICIT NONE
+      REAL(DP), INTENT(IN) :: vin(:,:)
+      LOGICAL,INTENT(in),OPTIONAL :: gather
+      !
+      INTEGER :: ispin, ns
+      LOGICAL :: gather_
+      !
+      gather_ = .true.
+      IF ( present(gather) ) gather_ = gather
+      !
+      call embed%allocate_extkin()
+      !
+      ns = size(vin,2)
+      CALL mp_bcast(ns, dfftp%root, dfftp%comm)
+      !
+      call qepy_get_value(vin(:,1:ns), embed%extkin(:,1:ns), scatter = gather_)
+      !
+      DO ispin = ns+1, nspin
+         embed%extkin(:,ispin) = embed%extkin(:,1)
+      END DO
+      !
+   END SUBROUTINE
+
+   SUBROUTINE qepy_set_tau(tau, gather)
+      ! xcSolidsBench: set rho%kin_r (QE convention: sum_i w_i |grad psi_i|^2, per spin up/down) and rho%kin_g,
+      ! a copy of qepy_set_rho for the kinetic energy density (no total/magnetization conversion: kin is per spin)
+      USE kinds,                ONLY : DP
+      USE fft_rho,              ONLY : rho_r2g
+      USE fft_base,             ONLY : dfftp
+      USE scf,                  ONLY : rho
+      USE xc_lib,               ONLY : xclib_dft_is
+      !
+      IMPLICIT NONE
+      REAL(DP), INTENT(IN) :: tau(:,:)
+      LOGICAL,INTENT(in),OPTIONAL :: gather
+      !
+      LOGICAL :: gather_
+      !
+      gather_ = .true.
+      IF ( present(gather) ) gather_ = gather
+      !
+      IF (.NOT. xclib_dft_is('meta')) CALL errore('qepy_set_tau', 'not a meta run: rho%kin is not allocated', 1)
+      call qepy_get_value(tau, rho%kin_r, scatter = gather_)
+      CALL rho_r2g(dfftp, rho%kin_r, rho%kin_g )
+   END SUBROUTINE
+
    FUNCTION qepy_get_grid(nr, gather) RESULT( nrw )
       USE kinds,                ONLY : DP
       USE fft_base,             ONLY : dfftp
