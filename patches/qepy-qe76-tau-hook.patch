+   SUBROUTINE allocate_extkin(embed)
+      ! xcSolidsBench tau hook: the tau potential array, same layout as extpot (dfftp%nnr x nspin, per spin)
+      USE kinds,                ONLY : DP
+      USE fft_base,             ONLY : dfftp
+      USE lsda_mod,             ONLY : lsda, nspin
+      !
+      IMPLICIT NONE
+      CLASS(embed_base), INTENT(INOUT) :: embed
+      !
+      IF (ALLOCATED(embed%extkin)) THEN
+         IF (SIZE(embed%extkin, 1) /= dfftp%nnr) DEALLOCATE(embed%extkin)
+      ENDIF
+      IF (.NOT.ALLOCATED(embed%extkin)) THEN
+         ALLOCATE(embed%extkin(dfftp%nnr, nspin))
+         embed%extkin = 0.0_DP
+      ENDIF
+   END SUBROUTINE
